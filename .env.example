# Optional. Without these, the app uses in-memory storage (fine for local use).
# With them, widgets are stored in Upstash Redis (required on Vercel/serverless).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
